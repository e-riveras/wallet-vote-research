{
    "name": "Wallet Vote Research",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.vscode-pylint"
            ]
        }
    },
    "forwardPorts": [8888],
    "postCreateCommand": "pip install -r requirements.txt",
    "remoteUser": "root"
}
